{
  "version": 2,
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "api/mplads_dev.db"
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/dossier",
      "destination": "/dossier.html"
    },
    {
      "source": "/docs",
      "destination": "/documentation.html"
    },
    {
      "source": "/documentation",
      "destination": "/documentation.html"
    },
    {
      "source": "/summary",
      "destination": "/summary.html"
    },
    {
      "source": "/((?!api|assets|favicon|data|documentation|dossier|summary|.*\\.pdf|.*\\.html|.*\\.svg|.*\\.ico|.*\\.json).*)",
      "destination": "/index.html"
    }
  ]
}