{
  "version": 2,
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/*.py": {
      "includeFiles": "{api/mplads_dev.db,data/*.csv,data/*.json,01_Overview_and_National_Summary/**,02_States_and_UTs/**,03_MPs_Data/**,05_Analytics_and_Trends/**,09_MP_Demographics_ADR/**}",
      "excludeFiles": "{web/**,data/*.geojson,data/works_*.csv}"
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/dossier",
      "destination": "/dossier.html"
    },
    {
      "source": "/docs",
      "destination": "/documentation.html"
    },
    {
      "source": "/documentation",
      "destination": "/documentation.html"
    },
    {
      "source": "/summary",
      "destination": "/summary.html"
    },
    {
      "source": "/((?!api|assets|favicon|data|documentation|dossier|summary|.*\\.pdf|.*\\.html|.*\\.svg|.*\\.ico|.*\\.json).*)",
      "destination": "/index.html"
    }
  ]
}