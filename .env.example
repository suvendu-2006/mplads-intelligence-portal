# Application Environment: development | staging | production
APP_ENV=development

# Database Configuration (Use postgresql://... in production)
DATABASE_URL=sqlite:///mplads_dev.db
# DB_PASSWORD=your_secure_db_password_here # (Required if using PostgreSQL in production/staging)

# Data Directories
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts

# Logging Level
LOG_LEVEL=INFO

# Feature Flags
DEMO_MODE=false
ML_PREDICTIONS_ENABLED=false

# Security Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=<generate_with_secrets_token_hex_32>
