# Application Environment: development | staging | production
APP_ENV=development

# Database Configuration (Use postgresql://... in production)
DATABASE_URL=sqlite:///mplads_dev.db

# Data Directories
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts

# Logging Level
LOG_LEVEL=INFO

# Feature Flags
DEMO_MODE=false
ML_PREDICTIONS_ENABLED=false

